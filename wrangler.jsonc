{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jevon",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-02",
  "vars": {
    "VITE_API_BASE_URL": "https://jevon-api.onrender.com",
  },
  "kv_namespaces": [
    {
      "binding": "JEVON_STATE",
      "id": "7f1ed2b6b9934a339a2b770fa56f4e94",
    },
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/warm/*"],
    "not_found_handling": "single-page-application",
  },
}
